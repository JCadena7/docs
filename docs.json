            "pages": [
              "active-projects",
              "completed-projects"
            ]
          },
          {
            "group": "Publicaciones y artículos",
            "pages": [
              "research-papers",
              "divulgation-articles",
              "conference-papers"
            ]
          },
          {
            "group": "Menciones y reconocimientos",
            "pages": [
              "mentions"
            ]
          },
          {
            "group": "Recursos",
            "pages": [
              "tools",
              "datasets",
              "references"
            ]
          }
        ]
